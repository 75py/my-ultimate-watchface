<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  My Ultimate Watch Face — Watch Face Format v2 (Wear OS 5 / API 34+)

  Layout on a 450x450 virtual canvas (scaled to the physical display):
    - top center    : date (M月D日（曜）)
    - below date    : weather block (icon + current temp + today high/low + condition name)
    - upper left    : heart rate ring gauge (9-11 o'clock, pink ring, value inside,
                      heart icon in the ring's gap)
    - upper right   : next alarm ring gauge (1-3 o'clock, indigo ring, editable slot)
    - center        : large HH:MM at the geometric center, fixed position,
                      per-digit boxes so changing digits never shift the layout
    - right of MM   : small seconds (interactive mode only)
    - lower left    : steps (green rim arc 9->7 o'clock driven by STEP_PERCENT)
    - bottom        : distance (blue rim arc 7->5 o'clock, editable slot)
    - lower right   : calories burned (orange rim arc 5->3 o'clock, editable slot)
  The three rim arcs are progress gauges. WFF expressions cannot read a
  complication's value outside its slot, so the distance/calories arcs are
  drawn *inside* their ComplicationSlot with a full-canvas PartDraw offset by
  the slot origin (the technique Watch Face Designer exports use); they fill
  for GOAL_PROGRESS / RANGED_VALUE providers and show only the dim track for
  SHORT_TEXT / EMPTY. All three arcs fill counter-clockwise (left -> bottom
  -> right), matching sample.png.
  Ambient (AOD): only the date and HH:MM remain, dimmed, at identical positions.

  This file is generated from a small template script; it is also fine to
  edit by hand.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:36" />
  <Metadata key="STEP_GOAL" value="10000" />

  <!-- Weather condition icons, selected by the [WEATHER.CONDITION] enum value
       rendered through a BitmapFont (same technique as the official Weather sample). -->
  <BitmapFonts>
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_clear_day" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_sunny" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_day" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_night" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_night" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_night" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff000000">

    <!-- ============================================================ -->
    <!-- Elements kept in ambient mode (dimmed): date + HH:MM         -->
    <!-- Their geometry never changes between interactive and ambient -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="ambient_kept">
      <Variant mode="AMBIENT" target="alpha" value="150" />

      <!-- Date: 9月15日（火） — tap opens the calendar app -->
      <PartText x="100" y="56" width="250" height="34" name="date">
        <Launch target="CALENDAR" />
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
        <Text align="CENTER">
          <Font family="poppins_medium" size="26" color="#ffffffff">
            <Template><![CDATA[%s月%s日（%s）]]>
              <Parameter expression="[MONTH]" />
              <Parameter expression="[DAY]" />
              <Parameter expression="[DAY_OF_WEEK_S]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- HH:MM — geometric center of the 450x450 canvas is (225,225);
           the clock group is centered on it horizontally. -->
      <Group x="83" y="168" width="284" height="120" name="clock">
        <DigitalClock x="0" y="0" width="284" height="120">
          <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
          <TimeText format="hh_10" hourFormat="24" x="0" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="#ffe9faf7" />
          </TimeText>
          <TimeText format="hh_1" hourFormat="24" x="64" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="#ffe9faf7" />
          </TimeText>
          <TimeText format="mm_10" hourFormat="24" x="156" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="#ffe9faf7" />
          </TimeText>
          <TimeText format="mm_1" hourFormat="24" x="220" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="#ffe9faf7" />
          </TimeText>
        </DigitalClock>
        <!-- static separator: never moves -->
        <PartText x="128" y="0" width="28" height="120" name="colon">
          <Text align="CENTER">
            <Font family="poppins_light" size="110" color="#ffe9faf7">:</Font>
          </Text>
        </PartText>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Interactive-only content (hidden in ambient mode)            -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="interactive_only" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- rim tick marks every 30 degrees -->
      <PartDraw x="0" y="0" width="450" height="450" name="ticks">
        <Line startX="225.0" startY="6.0" endX="225.0" endY="18.0"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="334.5" startY="35.3" endX="328.5" endY="45.7"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="414.7" startY="115.5" endX="404.3" endY="121.5"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="444.0" startY="225.0" endX="432.0" endY="225.0"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="414.7" startY="334.5" endX="404.3" endY="328.5"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="334.5" startY="414.7" endX="328.5" endY="404.3"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="225.0" startY="444.0" endX="225.0" endY="432.0"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="115.5" startY="414.7" endX="121.5" endY="404.3"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="35.3" startY="334.5" endX="45.7" endY="328.5"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="6.0" startY="225.0" endX="18.0" endY="225.0"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="35.3" startY="115.5" endX="45.7" endY="121.5"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
        <Line startX="115.5" startY="35.3" endX="121.5" endY="45.7"><Stroke color="#ff3a4046" thickness="2.5" cap="ROUND" /></Line>
      </PartDraw>

      <!-- dim rim tracks for the three progress arcs (ring radius 200,
           thickness 10): steps green 9-7 o'clock, distance blue 7-5 o'clock,
           calories orange 5-3 o'clock. The bright fill is drawn separately:
           steps below, distance/calories inside their complication slots. -->
      <PartDraw x="0" y="0" width="450" height="450" name="arc_tracks">
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="212" endAngle="265">
          <Stroke color="#553ddc97" thickness="10" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="157" endAngle="203">
          <Stroke color="#554da3ff" thickness="10" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="95" endAngle="148">
          <Stroke color="#55ff8a3d" thickness="10" cap="ROUND" />
        </Arc>
      </PartDraw>

      <!-- steps progress arc: driven by STEP_PERCENT, only when a step goal exists.
           Fills counter-clockwise from 9 o'clock toward 7 o'clock; hidden at 0%. -->
      <Condition>
        <Expressions>
          <Expression name="has_step_goal"><![CDATA[[STEP_GOAL] > 0]]></Expression>
        </Expressions>
        <Compare expression="has_step_goal">
          <PartDraw x="0" y="0" width="450" height="450" name="arc_steps_progress">
            <Transform target="alpha" value="(clamp([STEP_PERCENT], 0, 100) / 100) &gt; 0 ? 255 : 0" />
            <Arc centerX="225" centerY="225" width="400" height="400" startAngle="265" endAngle="212" direction="COUNTER_CLOCKWISE">
              <Transform target="endAngle" value="265 - 53 * (clamp([STEP_PERCENT], 0, 100) / 100)" />
              <Stroke color="#ff3ddc97" thickness="10" cap="ROUND" />
            </Arc>
          </PartDraw>
        </Compare>
        <Default>
          <Group x="0" y="0" width="1" height="1" name="arc_steps_none" />
        </Default>
      </Condition>

      <!-- Weather: one consolidated area (icon + current temp + today's
           high/low + condition name). -->
      <Group x="136" y="93" width="184" height="70" name="weather">
        <Launch target="com.google.android.wearable.weather" />
        <Condition>
          <Expressions>
            <Expression name="weather_available"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
          </Expressions>
          <Compare expression="weather_available">
            <Group x="0" y="0" width="184" height="70" name="weather_ok">
              <Condition>
                <Expressions>
                  <Expression name="is_day"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                </Expressions>
                <Compare expression="is_day">
                  <PartText x="0" y="0" width="36" height="36" name="w_icon">
                    <Text>
                      <BitmapFont family="weather_icons_day" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <PartText x="0" y="0" width="36" height="36" name="w_icon_night">
                    <Text>
                      <BitmapFont family="weather_icons_night" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Default>
              </Condition>
              <PartText x="40" y="0" width="58" height="36" name="w_temp_now">
                <Text align="START">
                  <Font family="poppins_medium" size="32" color="#ffffffff">
                    <Template><![CDATA[%d°]]>
                      <Parameter expression="[WEATHER.TEMPERATURE]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="100" y="10" width="84" height="26" name="w_temp_hilo">
                <Text align="START" ellipsis="TRUE">
                  <Font family="poppins_regular" size="17" color="#ff9e9e9e">
                    <Template><![CDATA[/ %d° %d°]]>
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="0" y="44" width="184" height="24" name="w_condition">
                <Text align="CENTER" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="16" color="#ffb0bec5">
                    <Template><![CDATA[%s]]>
                      <Parameter expression="[WEATHER.CONDITION_NAME]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Compare>
          <Default>
            <Group x="0" y="0" width="184" height="70" name="weather_na">
              <PartText x="0" y="4" width="184" height="34" name="w_na">
                <Text align="CENTER">
                  <Font family="poppins_medium" size="28" color="#ff9e9e9e">--°</Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Group>

      <!-- Seconds — to the right of HH:MM, baseline-aligned near y=258 -->
      <PartText x="370" y="214" width="58" height="44" name="seconds">
        <Text align="START">
          <Font family="poppins_medium" size="38" color="#ff89a4d0">
            <Template><![CDATA[%s]]>
              <Parameter expression="[SECOND_Z]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- Heart rate (9-11 o'clock ring gauge): full pink ring, value + bpm
           inside, heart icon in the ring's gap. Tap opens the heart-rate app. -->
      <Group x="54" y="94" width="80" height="92" name="heart_rate">
        <Launch target="HEALTH_HEART_RATE" />
        <PartDraw x="0" y="0" width="80" height="92" name="hr_ring">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="#ffff5a7e" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="hr_valid"><![CDATA[round([HEART_RATE]) >= 1]]></Expression>
          </Expressions>
          <Compare expression="hr_valid">
            <PartText x="8" y="22" width="64" height="28" name="hr_value">
              <Text align="CENTER">
                <Font family="poppins_medium" size="22" color="#ffffffff">
                  <Template><![CDATA[%d]]>
                    <Parameter expression="round([HEART_RATE])" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="8" y="22" width="64" height="28" name="hr_value_na">
              <Text align="CENTER">
                <Font family="poppins_medium" size="22" color="#ff9e9e9e">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="10" y="47" width="60" height="15" name="hr_unit">
          <Text align="CENTER">
            <Font family="poppins_regular" size="12" color="#ff8a9199">bpm</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="hr_icon">
          <Image resource="ic_heart" />
        </PartImage>
      </Group>

      <!-- Steps (lower left, mirrored with calories about the vertical axis);
           tapping any element opens the health app (Fitbit on Pixel Watch) -->
      <PartImage x="84" y="280" width="24" height="24" name="steps_icon">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps" />
      </PartImage>
      <PartText x="48" y="306" width="96" height="28" name="steps_value">
        <Launch target="com.fitbit.FitbitMobile" />
        <Text align="CENTER">
          <Font family="poppins_medium" size="24" color="#ffffffff">
            <Template><![CDATA[%,d]]>
              <Parameter expression="[STEP_COUNT]" />
            </Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="48" y="334" width="96" height="14" name="steps_goal">
        <Launch target="com.fitbit.FitbitMobile" />
        <Text align="CENTER">
          <Font family="poppins_regular" size="12" color="#ff8a9199">
            <Template><![CDATA[/ %,d]]>
              <Parameter expression="[STEP_GOAL]" />
            </Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- ============================================================ -->
    <!-- Editable complication slots                                  -->
    <!-- ============================================================ -->

    <!-- Next alarm (1-3 o'clock ring gauge; user assigns the clock app's
         alarm complication). Full indigo ring, time inside, icon in the gap. -->
    <ComplicationSlot x="316" y="94" width="80" height="92" slotId="10"
        displayName="slot_alarm" isCustomizable="TRUE"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="80" height="92" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="SHORT_TEXT">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_st">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="#ff8fa8ff" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="alarm_has_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="alarm_has_text">
            <PartText x="8" y="22" width="64" height="28" name="alarm_text">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_medium" size="20" color="#ffffffff">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="8" y="22" width="64" height="28" name="alarm_none">
              <Text align="CENTER">
                <Font family="poppins_medium" size="20" color="#ff9e9e9e">なし</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_st">
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="#ff8a9199">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_st">
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>

      <Complication type="MONOCHROMATIC_IMAGE">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_img">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="#ff8fa8ff" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartImage x="26" y="18" width="28" height="28" name="alarm_img" tintColor="#ff8fa8ff">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_img">
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="#ff8a9199">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_img">
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>

      <Complication type="EMPTY">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_empty">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="#888fa8ff" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartText x="8" y="22" width="64" height="28" name="alarm_empty">
          <Launch target="ALARM" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="16" color="#ff9e9e9e">未設定</Font>
          </Text>
        </PartText>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_empty">
          <Launch target="ALARM" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="#ff8a9199">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_empty">
          <Launch target="ALARM" />
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Distance (bottom; user assigns a distance complication). Blue rim arc fills for GOAL_PROGRESS / RANGED_VALUE. -->
    <ComplicationSlot x="173" y="314" width="104" height="72" slotId="11"
        displayName="slot_distance" isCustomizable="TRUE"
        supportedTypes="GOAL_PROGRESS RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="104" height="72" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="GOAL_PROGRESS">
        <PartDraw x="-173" y="-314" width="450" height="450" name="dist_goal_arc">
          <Transform target="alpha" value="(clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / max(0.0001, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]), 0, 1)) &gt; 0 ? 255 : 0" />
          <Arc centerX="225" centerY="225" width="400" height="400" startAngle="203" endAngle="157" direction="COUNTER_CLOCKWISE">
            <Transform target="endAngle" value="203 - 46 * (clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / max(0.0001, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]), 0, 1))" />
            <Stroke color="#ff4da3ff" thickness="10" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartImage x="40" y="4" width="24" height="24" name="dist_icon_goal">
          <Image resource="ic_distance" />
        </PartImage>
        <Condition>
          <Expressions>
            <Expression name="dist_goal_has_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_goal_has_text">
            <PartText x="0" y="30" width="104" height="28" name="dist_goal_text">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_medium" size="24" color="#ffffffff">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="0" y="30" width="104" height="28" name="dist_goal_text_na">
              <Text align="CENTER">
                <Font family="poppins_medium" size="24" color="#ff9e9e9e">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <Condition>
          <Expressions>
