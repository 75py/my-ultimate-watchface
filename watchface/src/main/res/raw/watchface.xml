                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="45" y="132" width="100" height="32" name="dist_text_na">
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ff6b7480">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="45" y="162" width="100" height="16" name="dist_unit_gp">
