<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  My Ultimate Watch Face — Watch Face Format v2 (Wear OS 5 / API 34+)

  Layout on a 450x450 virtual canvas (scaled to the physical display):
    - top center    : date (M月D日（曜）) over a weather block
                      (current temp + today high/low + condition name)
    - upper center  : large HH:MM, fixed position, per-digit boxes so
                      changing digits never shift the layout
    - bottom center : small seconds (interactive mode only)
    - lower flanks  : two inner ring gauges (next alarm at 8 o'clock,
                      heart rate at 4 o'clock), icon in the ring's bottom gap
    - outer rim     : three progress items drawn as a rim arc with a donut
                      dot at the track start and a curved icon+value label
                      just outside it — steps (upper left), distance
                      (lower right), calories (lower left)
  Rim arc fills grow clockwise from the dot. WFF expressions cannot read a
  complication's value outside its slot, so the distance/calories arcs and
  their curved labels are drawn *inside* their ComplicationSlot with
  full-canvas parts offset by the slot origin (the technique Watch Face
  Designer exports use); they fill for GOAL_PROGRESS / RANGED_VALUE
  providers and show only the dim track for SHORT_TEXT / EMPTY.
  A ColorConfiguration theme sets every accent (arcs, rings, icons,
  seconds, dots) and text color in one place.
  Ambient (AOD): only the date and HH:MM remain, dimmed, at identical positions.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:36" />
  <Metadata key="STEP_GOAL" value="10000" />

  <!-- Weather condition icons, selected by the [WEATHER.CONDITION] enum value
       rendered through a BitmapFont (same technique as the official Weather sample). -->
  <BitmapFonts>
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_clear_day" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_sunny" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_day" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_night" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_night" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_night" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
  </BitmapFonts>

  <!-- Single color theme for the whole face.
       colors[0] accent  : arc fills, ring strokes, icon tints, dots, seconds
       colors[1] track   : dim arc tracks / empty ring
       colors[2] text    : primary values and labels
       colors[3] sub     : secondary labels and fallbacks -->
  <UserConfigurations>
    <ColorConfiguration id="theme" displayName="theme_colors" defaultValue="theme_mint">
      <ColorOption id="theme_mint"     displayName="theme_mint"     colors="#ff7ce3a9 #ff26523d #ffe9faf7 #ff8a9199" />
      <ColorOption id="theme_blue"     displayName="theme_blue"     colors="#ff58b0ff #ff21445f #ffe9f4ff #ff8a9199" />
      <ColorOption id="theme_lavender" displayName="theme_lavender" colors="#ffc0a6ff #ff403a66 #fff1edff #ff8a9199" />
      <ColorOption id="theme_amber"    displayName="theme_amber"    colors="#ffffc470 #ff5f452a #fffff7ec #ff8a9199" />
      <ColorOption id="theme_rose"     displayName="theme_rose"     colors="#ffff8da6 #ff61303f #fffff0f3 #ff8a9199" />
    </ColorConfiguration>
  </UserConfigurations>

  <Scene backgroundColor="#ff000000">

    <!-- ============================================================ -->
    <!-- Elements kept in ambient mode (dimmed): date + HH:MM         -->
    <!-- Their geometry never changes between interactive and ambient -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="ambient_kept">
      <Variant mode="AMBIENT" target="alpha" value="150" />

      <!-- Date: 9月15日（火） — tap opens the calendar app -->
      <PartText x="100" y="56" width="250" height="34" name="date">
        <Launch target="CALENDAR" />
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
        <Text align="CENTER">
          <Font family="poppins_medium" size="26" color="[CONFIGURATION.theme.2]">
            <Template><![CDATA[%s月%s日（%s）]]>
              <Parameter expression="[MONTH]" />
              <Parameter expression="[DAY]" />
              <Parameter expression="[DAY_OF_WEEK_S]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- HH:MM — geometric center of the 450x450 canvas is (225,225);
           the clock group is centered on it horizontally. -->
      <Group x="83" y="168" width="284" height="120" name="clock">
        <DigitalClock x="0" y="0" width="284" height="120">
          <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
          <TimeText format="hh_10" hourFormat="24" x="0" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="[CONFIGURATION.theme.2]" />
          </TimeText>
          <TimeText format="hh_1" hourFormat="24" x="64" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="[CONFIGURATION.theme.2]" />
          </TimeText>
          <TimeText format="mm_10" hourFormat="24" x="156" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="[CONFIGURATION.theme.2]" />
          </TimeText>
          <TimeText format="mm_1" hourFormat="24" x="220" y="0" width="64" height="120" align="CENTER">
            <Font family="poppins_light" size="110" color="[CONFIGURATION.theme.2]" />
          </TimeText>
        </DigitalClock>
        <!-- static separator: never moves -->
        <PartText x="128" y="0" width="28" height="120" name="colon">
          <Text align="CENTER">
            <Font family="poppins_light" size="110" color="[CONFIGURATION.theme.2]">:</Font>
          </Text>
        </PartText>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Interactive-only content (hidden in ambient mode)            -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="interactive_only" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- dim rim tracks (ring radius 200, thickness 12): steps upper-left,
           distance lower-right, calories lower-left. Bright fills are drawn
           separately: steps below, distance/calories inside their slots. -->
      <PartDraw x="0" y="0" width="450" height="450" name="arc_tracks">
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="315" endAngle="349">
          <Stroke color="[CONFIGURATION.theme.1]" thickness="12" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="136" endAngle="170">
          <Stroke color="[CONFIGURATION.theme.1]" thickness="12" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="400" height="400" startAngle="228" endAngle="262">
          <Stroke color="[CONFIGURATION.theme.1]" thickness="12" cap="ROUND" />
        </Arc>
      </PartDraw>

      <!-- donut dots marking each track's start (fill origin) -->
      <PartDraw x="0" y="0" width="450" height="450" name="arc_dots">
        <Ellipse x="65.1" y="84.8" width="18" height="18"><Fill color="[CONFIGURATION.theme.0]" /></Ellipse>
        <Ellipse x="69.6" y="89.3" width="9" height="9"><Fill color="#ff000000" /></Ellipse>
        <Ellipse x="364.6" y="349.8" width="18" height="18"><Fill color="[CONFIGURATION.theme.0]" /></Ellipse>
        <Ellipse x="369.1" y="354.3" width="9" height="9"><Fill color="#ff000000" /></Ellipse>
        <Ellipse x="77.1" y="359.9" width="18" height="18"><Fill color="[CONFIGURATION.theme.0]" /></Ellipse>
        <Ellipse x="81.6" y="364.4" width="9" height="9"><Fill color="#ff000000" /></Ellipse>
      </PartDraw>

      <!-- steps progress arc: driven by STEP_PERCENT, only when a step goal
           exists. Fills clockwise from the dot; hidden at 0%. -->
      <Condition>
        <Expressions>
          <Expression name="has_step_goal"><![CDATA[[STEP_GOAL] > 0]]></Expression>
        </Expressions>
        <Compare expression="has_step_goal">
          <PartDraw x="0" y="0" width="450" height="450" name="arc_steps_progress">
            <Transform target="alpha" value="(clamp([STEP_PERCENT], 0, 100) / 100) &gt; 0 ? 255 : 0" />
            <Arc centerX="225" centerY="225" width="400" height="400" startAngle="315" endAngle="315" direction="CLOCKWISE">
              <Transform target="endAngle" value="315 + 34 * (clamp([STEP_PERCENT], 0, 100) / 100)" />
              <Stroke color="[CONFIGURATION.theme.0]" thickness="12" cap="ROUND" />
            </Arc>
          </PartDraw>
        </Compare>
        <Default>
          <Group x="0" y="0" width="1" height="1" name="arc_steps_none" />
        </Default>
      </Condition>

      <!-- rim item icons + curved labels (text radius 181, icons at 184) -->
      <PartImage x="31" y="195" width="22" height="22" name="steps_icon" tintColor="[CONFIGURATION.theme.0]"
          angle="340" pivotX="0.5" pivotY="0.5">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps" />
      </PartImage>
      <PartImage x="397" y="224" width="22" height="22" name="dist_icon" tintColor="[CONFIGURATION.theme.0]"
          angle="20" pivotX="0.5" pivotY="0.5">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_distance" />
      </PartImage>
      <PartImage x="188" y="396" width="22" height="22" name="cal_icon" tintColor="[CONFIGURATION.theme.0]"
          angle="340" pivotX="0.5" pivotY="0.5">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_calories" />
      </PartImage>
      <PartText x="0" y="0" width="450" height="450" name="steps_label">
        <Launch target="com.fitbit.FitbitMobile" />
        <TextCircular centerX="225" centerY="225" width="362" height="362"
            startAngle="280" endAngle="306" direction="CLOCKWISE" align="CENTER">
          <Font family="poppins_medium" size="22" color="[CONFIGURATION.theme.2]">
            <Template><![CDATA[%,d]]>
              <Parameter expression="[STEP_COUNT]" />
            </Template>
          </Font>
        </TextCircular>
      </PartText>

      <!-- Weather: one consolidated area (icon + current temp + today's
           high/low + condition name). -->
      <Group x="136" y="93" width="184" height="70" name="weather">
        <Launch target="com.google.android.wearable.weather" />
        <Condition>
          <Expressions>
            <Expression name="weather_available"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
          </Expressions>
          <Compare expression="weather_available">
            <Group x="0" y="0" width="184" height="70" name="weather_ok">
              <Condition>
                <Expressions>
                  <Expression name="is_day"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                </Expressions>
                <Compare expression="is_day">
                  <PartText x="0" y="0" width="36" height="36" name="w_icon">
                    <Text>
                      <BitmapFont family="weather_icons_day" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <PartText x="0" y="0" width="36" height="36" name="w_icon_night">
                    <Text>
                      <BitmapFont family="weather_icons_night" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Default>
              </Condition>
              <PartText x="40" y="0" width="58" height="36" name="w_temp_now">
                <Text align="START">
                  <Font family="poppins_medium" size="32" color="[CONFIGURATION.theme.2]">
                    <Template><![CDATA[%d°]]>
                      <Parameter expression="[WEATHER.TEMPERATURE]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="100" y="10" width="84" height="26" name="w_temp_hilo">
                <Text align="START" ellipsis="TRUE">
                  <Font family="poppins_regular" size="17" color="[CONFIGURATION.theme.3]">
                    <Template><![CDATA[/ %d° %d°]]>
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="0" y="44" width="184" height="24" name="w_condition">
                <Text align="CENTER" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.theme.3]">
                    <Template><![CDATA[%s]]>
                      <Parameter expression="[WEATHER.CONDITION_NAME]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Compare>
          <Default>
            <Group x="0" y="0" width="184" height="70" name="weather_na">
              <PartText x="0" y="4" width="184" height="34" name="w_na">
                <Text align="CENTER">
                  <Font family="poppins_medium" size="28" color="[CONFIGURATION.theme.3]">--°</Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Group>

      <!-- Seconds — bottom center -->
      <PartText x="195" y="350" width="60" height="40" name="seconds">
        <Text align="CENTER">
          <Font family="poppins_medium" size="30" color="[CONFIGURATION.theme.0]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[SECOND_Z]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- Heart rate (4 o'clock inner ring gauge): ring with a bottom gap,
           value + bpm inside, heart icon in the gap.
           Tap opens the heart-rate app. -->
      <Group x="292" y="248" width="80" height="92" name="heart_rate">
        <Launch target="HEALTH_HEART_RATE" />
        <PartDraw x="0" y="0" width="80" height="92" name="hr_ring">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="hr_valid"><![CDATA[round([HEART_RATE]) >= 1]]></Expression>
          </Expressions>
          <Compare expression="hr_valid">
            <PartText x="8" y="22" width="64" height="28" name="hr_value">
              <Text align="CENTER">
                <Font family="poppins_medium" size="22" color="[CONFIGURATION.theme.2]">
                  <Template><![CDATA[%d]]>
                    <Parameter expression="round([HEART_RATE])" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="8" y="22" width="64" height="28" name="hr_value_na">
              <Text align="CENTER">
                <Font family="poppins_medium" size="22" color="[CONFIGURATION.theme.3]">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="10" y="47" width="60" height="15" name="hr_unit">
          <Text align="CENTER">
            <Font family="poppins_regular" size="12" color="[CONFIGURATION.theme.3]">bpm</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="hr_icon" tintColor="[CONFIGURATION.theme.0]">
          <Image resource="ic_heart" />
        </PartImage>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Editable complication slots                                  -->
    <!-- ============================================================ -->

    <!-- Next alarm (8 o'clock inner ring gauge; user assigns the clock app's
         alarm complication). Ring with a bottom gap, time inside, icon in
         the gap. -->
    <ComplicationSlot x="78" y="248" width="80" height="92" slotId="10"
        displayName="slot_alarm" isCustomizable="TRUE"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="80" height="92" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="SHORT_TEXT">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_st">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="alarm_has_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="alarm_has_text">
            <PartText x="8" y="22" width="64" height="28" name="alarm_text">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_medium" size="20" color="[CONFIGURATION.theme.2]">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="8" y="22" width="64" height="28" name="alarm_none">
              <Text align="CENTER">
                <Font family="poppins_medium" size="20" color="[CONFIGURATION.theme.3]">なし</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_st">
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="[CONFIGURATION.theme.3]">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_st" tintColor="[CONFIGURATION.theme.0]">
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>

      <Complication type="MONOCHROMATIC_IMAGE">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_img">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartImage x="26" y="18" width="28" height="28" name="alarm_img" tintColor="[CONFIGURATION.theme.0]">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_img">
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="[CONFIGURATION.theme.3]">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_img" tintColor="[CONFIGURATION.theme.0]">
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>

      <Complication type="EMPTY">
        <PartDraw x="0" y="0" width="80" height="92" name="alarm_ring_empty">
          <Arc centerX="40" centerY="40" width="68" height="68" startAngle="210" endAngle="510">
            <Stroke color="[CONFIGURATION.theme.1]" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartText x="8" y="22" width="64" height="28" name="alarm_empty">
          <Launch target="ALARM" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.theme.3]">未設定</Font>
          </Text>
        </PartText>
        <PartText x="10" y="47" width="60" height="15" name="alarm_label_empty">
          <Launch target="ALARM" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="[CONFIGURATION.theme.3]">アラーム</Font>
          </Text>
        </PartText>
        <PartImage x="31" y="66" width="18" height="18" name="alarm_icon_empty" tintColor="[CONFIGURATION.theme.0]">
          <Launch target="ALARM" />
          <Image resource="ic_alarm" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Distance (lower-right rim; user assigns a distance complication).
         Slot box covers the icon+curved-label cluster on the rim; the fill
         arc and curved value are drawn with full-canvas offset parts. -->
    <ComplicationSlot x="352" y="220" width="88" height="96" slotId="11"
        displayName="slot_distance" isCustomizable="TRUE"
        supportedTypes="GOAL_PROGRESS RANGED_VALUE SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="88" height="96" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="GOAL_PROGRESS">
        <PartDraw x="-352" y="-220" width="450" height="450" name="dist_goal_arc">
          <Transform target="alpha" value="(clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / max(0.0001, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]), 0, 1)) &gt; 0 ? 255 : 0" />
          <Arc centerX="225" centerY="225" width="400" height="400" startAngle="136" endAngle="136" direction="CLOCKWISE">
            <Transform target="endAngle" value="136 + 34 * (clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / max(0.0001, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]), 0, 1))" />
            <Stroke color="[CONFIGURATION.theme.0]" thickness="12" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="dist_goal_has_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_goal_has_text">
            <PartText x="-352" y="-220" width="450" height="450" name="dist_goal_text">
              <TextCircular centerX="225" centerY="225" width="362" height="362"
                  startAngle="101" endAngle="127" direction="CLOCKWISE" align="CENTER">
                <Font family="poppins_medium" size="22" color="[CONFIGURATION.theme.2]">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </TextCircular>
            </PartText>
