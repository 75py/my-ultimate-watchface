<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  My Ultimate Watch Face — Watch Face Format v2 (Wear OS 5 / API 34+)

  450x450 virtual canvas (scaled to the physical display), center = (225, 225).

    - top center    : date (M月D日（曜）)
    - below date    : weather (icon + current temp + today high/low + condition)
    - center        : large bold HH:MM, horizontally centered, per-digit boxes
                      so changing digits never shift the layout
    - right of MM   : light seconds, baseline-aligned (interactive only)
    - upper left    : heart rate (10 o'clock)
    - upper right   : next alarm (2 o'clock, editable complication slot)
    - lower left    : steps + goal (8 o'clock)
    - bottom        : distance (6 o'clock, editable complication slot)
    - lower right   : calories burned (4 o'clock, editable complication slot)

  Rim ring: five 48° segments on a radius-204 circle, one per item, open at
  the top. Each segment is a dark tinted track ([CONFIGURATION.color.2]);
  the accent ([CONFIGURATION.color.1]) fills it with REAL progress where the
  data exists (steps → [STEP_PERCENT], distance/calories → GOAL_PROGRESS
  complications). Heart rate and alarm have no progress semantics, so their
  segments are solid accent decoration. A wide translucent arc under each
  lit segment gives a soft glow.

  Segment angles (0 = 12 o'clock, clockwise):
    alarm 36–84, calories 96–144, distance 156–204, steps 216–264, heart 276–324

  Ambient (AOD): only HH:MM remains (same boxes, lighter weight, dimmed).
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:36" />
  <Metadata key="STEP_GOAL" value="10000" />

  <!-- Theme colors: color.1 = accent, color.2 = dark tinted track -->
  <UserConfigurations>
    <ColorConfiguration id="color" displayName="color_theme" defaultValue="mint">
      <ColorOption id="mint" displayName="color_mint" colors="#00000000 #ffbdfff1 #ff1f3a33" />
      <ColorOption id="blue" displayName="color_blue" colors="#00000000 #ffbbdfff #ff223549" />
      <ColorOption id="orange" displayName="color_orange" colors="#00000000 #ffffd4af #ff45311f" />
    </ColorConfiguration>
  </UserConfigurations>

  <BitmapFonts>
    <!-- Weather condition icons, selected by the [WEATHER.CONDITION] enum value
         rendered through a BitmapFont (same technique as the official Weather sample).
         These PNGs are already colored, so no tint is applied. -->
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_clear_day" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_sunny" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_day" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_night" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_night" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_night" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>

    <!-- Inter bitmap fonts for the clock (white glyphs on a 200px-high cell,
         digits occupy rows 25–177; tinted by the theme accent color).
         Bold = HH:MM, Regular = seconds and the ambient clock. -->
    <BitmapFont name="interregular">
      <Character name="0" resource="font_interregular_0" width="125" height="200" />
      <Character name="1" resource="font_interregular_1" width="93" height="200" />
      <Character name="2" resource="font_interregular_2" width="122" height="200" />
      <Character name="3" resource="font_interregular_3" width="128" height="200" />
      <Character name="4" resource="font_interregular_4" width="129" height="200" />
      <Character name="5" resource="font_interregular_5" width="122" height="200" />
      <Character name="6" resource="font_interregular_6" width="125" height="200" />
      <Character name="7" resource="font_interregular_7" width="115" height="200" />
      <Character name="8" resource="font_interregular_8" width="124" height="200" />
      <Character name="9" resource="font_interregular_9" width="125" height="200" />
      <Character name=":" resource="font_interregular_colon" width="56" height="200" />
    </BitmapFont>
    <BitmapFont name="interbold">
      <Character name="0" resource="font_interbold_0" width="138" height="200" />
      <Character name="1" resource="font_interbold_1" width="98" height="200" />
      <Character name="2" resource="font_interbold_2" width="126" height="200" />
      <Character name="3" resource="font_interbold_3" width="132" height="200" />
      <Character name="4" resource="font_interbold_4" width="136" height="200" />
      <Character name="5" resource="font_interbold_5" width="129" height="200" />
      <Character name="6" resource="font_interbold_6" width="133" height="200" />
      <Character name="7" resource="font_interbold_7" width="119" height="200" />
      <Character name="8" resource="font_interbold_8" width="133" height="200" />
      <Character name="9" resource="font_interbold_9" width="133" height="200" />
      <Character name=":" resource="font_interbold_colon" width="60" height="200" />
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff000000">

    <!-- ============================================================ -->
    <!-- Ambient-only content: dimmed HH:MM in exactly the same boxes -->
    <!-- as the interactive clock, in the lighter Regular weight.     -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="ambient_only" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="150" />

      <PartText x="79" y="170" width="66" height="96" name="aod_h10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([HOUR_0_23]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="145" y="170" width="66" height="96" name="aod_h1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[HOUR_0_23]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="211" y="170" width="28" height="96" name="aod_colon">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="96" color="[CONFIGURATION.color.1]">:</BitmapFont>
        </Text>
      </PartText>
      <PartText x="239" y="170" width="66" height="96" name="aod_m10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([MINUTE]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="305" y="170" width="66" height="96" name="aod_m1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[MINUTE]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
    </Group>

    <!-- ============================================================ -->
    <!-- Interactive-only content (hidden in ambient mode)            -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="interactive_only" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- Rim ring: dark tinted track segments (radius 204) -->
      <PartDraw x="0" y="0" width="450" height="450" name="ring_tracks">
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="36" endAngle="84">
          <Stroke color="[CONFIGURATION.color.2]" thickness="9" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="96" endAngle="144">
          <Stroke color="[CONFIGURATION.color.2]" thickness="9" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="156" endAngle="204">
          <Stroke color="[CONFIGURATION.color.2]" thickness="9" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="216" endAngle="264">
          <Stroke color="[CONFIGURATION.color.2]" thickness="9" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="276" endAngle="324">
          <Stroke color="[CONFIGURATION.color.2]" thickness="9" cap="ROUND" />
        </Arc>
      </PartDraw>

      <!-- Heart rate + alarm: solid accent segments with a soft glow
           (no progress semantics, purely decorative) -->
      <PartDraw x="0" y="0" width="450" height="450" name="ring_static_glow" alpha="40">
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="276" endAngle="324">
          <Stroke color="[CONFIGURATION.color.1]" thickness="20" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="36" endAngle="84">
          <Stroke color="[CONFIGURATION.color.1]" thickness="20" cap="ROUND" />
        </Arc>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" name="ring_static">
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="276" endAngle="324">
          <Stroke color="[CONFIGURATION.color.1]" thickness="9" cap="ROUND" />
        </Arc>
        <Arc centerX="225" centerY="225" width="408" height="408" startAngle="36" endAngle="84">
          <Stroke color="[CONFIGURATION.color.1]" thickness="9" cap="ROUND" />
        </Arc>
      </PartDraw>

      <!-- Steps: real progress ([STEP_PERCENT]) sweeping 216° → 264° -->
      <Condition>
        <Expressions>
          <Expression name="has_step_goal"><![CDATA[[STEP_GOAL] > 0]]></Expression>
        </Expressions>
        <Compare expression="has_step_goal">
          <PartDraw x="0" y="0" width="450" height="450" name="ring_steps_glow" alpha="40">
            <Arc centerX="225" centerY="225" width="408" height="408" startAngle="216" endAngle="216">
              <Stroke color="[CONFIGURATION.color.1]" thickness="20" cap="ROUND" />
              <Transform target="endAngle" value="216 + clamp([STEP_PERCENT], 0, 100) * 0.48" />
            </Arc>
          </PartDraw>
          <PartDraw x="0" y="0" width="450" height="450" name="ring_steps">
            <Arc centerX="225" centerY="225" width="408" height="408" startAngle="216" endAngle="216">
              <Stroke color="[CONFIGURATION.color.1]" thickness="9" cap="ROUND" />
              <Transform target="endAngle" value="216 + clamp([STEP_PERCENT], 0, 100) * 0.48" />
            </Arc>
          </PartDraw>
        </Compare>
        <Default>
          <Group x="0" y="0" width="1" height="1" name="ring_steps_none" />
        </Default>
      </Condition>

      <!-- Date: 9月15日（火） — tap opens the calendar app -->
      <PartText x="105" y="44" width="240" height="26" name="date">
        <Launch target="CALENDAR" />
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="21" weight="MEDIUM" color="#fff2f4f7">
            <Template><![CDATA[%s月%s日（%s）]]>
              <Parameter expression="[MONTH]" />
              <Parameter expression="[DAY]" />
              <Parameter expression="[DAY_OF_WEEK_S]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- Weather: icon + current temp + today's high/low + condition -->
      <Group x="135" y="76" width="180" height="64" name="weather">
        <Launch target="com.google.android.wearable.weather" />
        <Condition>
          <Expressions>
            <Expression name="weather_available"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
          </Expressions>
          <Compare expression="weather_available">
            <Group x="0" y="0" width="180" height="64" name="weather_ok">
              <Condition>
                <Expressions>
                  <Expression name="is_day"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                </Expressions>
                <Compare expression="is_day">
                  <PartText x="0" y="2" width="44" height="40" name="w_icon">
                    <Text align="CENTER">
                      <BitmapFont family="weather_icons_day" size="40">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <PartText x="0" y="2" width="44" height="40" name="w_icon_night">
                    <Text align="CENTER">
                      <BitmapFont family="weather_icons_night" size="40">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Default>
              </Condition>
              <PartText x="48" y="0" width="72" height="44" name="w_temp_now">
                <Text align="START">
                  <Font family="SYNC_TO_DEVICE" size="36" weight="MEDIUM" color="#ffffffff">
                    <Template><![CDATA[%d°]]>
                      <Parameter expression="[WEATHER.TEMPERATURE]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="120" y="20" width="60" height="18" name="w_temp_hilo">
                <Text align="START" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="13" color="#ff8f98a3">
                    <Template><![CDATA[%d° / %d°]]>
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="0" y="46" width="180" height="18" name="w_condition">
                <Text align="CENTER" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="13" color="#ff8f98a3">
                    <Template><![CDATA[%s]]>
                      <Parameter expression="[WEATHER.CONDITION_NAME]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Compare>
          <Default>
            <Group x="0" y="0" width="180" height="64" name="weather_na">
              <PartText x="0" y="4" width="180" height="36" name="w_na">
                <Text align="CENTER">
                  <Font family="SYNC_TO_DEVICE" size="28" weight="MEDIUM" color="#ff6b7480">--°</Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Group>

      <!-- HH:MM: bold, centered on x=225, per-digit fixed boxes -->
      <PartText x="79" y="170" width="66" height="96" name="h10">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([HOUR_0_23]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="145" y="170" width="66" height="96" name="h1">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[HOUR_0_23]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="211" y="170" width="28" height="96" name="colon">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="96" color="[CONFIGURATION.color.1]">:</BitmapFont>
        </Text>
      </PartText>
      <PartText x="239" y="170" width="66" height="96" name="m10">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([MINUTE]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="305" y="170" width="66" height="96" name="m1">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="96" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[MINUTE]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>

      <!-- Seconds: light weight, baseline-aligned with HH:MM -->
      <PartText x="372" y="229" width="19" height="30" name="s10" alpha="190">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="30" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([SECOND]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="391" y="229" width="19" height="30" name="s1" alpha="190">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="30" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[SECOND]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>

      <!-- Heart rate (10 o'clock): icon / value / bpm -->
      <Group x="0" y="0" width="450" height="450" name="heart_rate">
        <PartImage x="86" y="98" width="28" height="28" name="hr_icon" tintColor="[CONFIGURATION.color.1]">
          <Launch target="HEALTH_HEART_RATE" />
          <Image resource="ic_heart" />
        </PartImage>
        <Condition>
          <Expressions>
            <Expression name="hr_valid"><![CDATA[round([HEART_RATE]) >= 1]]></Expression>
          </Expressions>
          <Compare expression="hr_valid">
            <PartText x="60" y="130" width="80" height="32" name="hr_value">
              <Launch target="HEALTH_HEART_RATE" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                  <Template><![CDATA[%d]]>
                    <Parameter expression="round([HEART_RATE])" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="60" y="130" width="80" height="32" name="hr_value_na">
              <Launch target="HEALTH_HEART_RATE" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ff6b7480">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartText x="60" y="160" width="80" height="16" name="hr_unit">
          <Launch target="HEALTH_HEART_RATE" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="12" color="#ff8f98a3">bpm</Font>
          </Text>
        </PartText>
      </Group>

      <!-- Steps (8 o'clock): icon / count / goal;
           tapping any element opens the health app (Fitbit on Pixel Watch) -->
      <Group x="0" y="0" width="450" height="450" name="steps">
        <PartImage x="94" y="270" width="28" height="28" name="steps_icon" tintColor="[CONFIGURATION.color.1]">
          <Launch target="com.fitbit.FitbitMobile" />
          <Image resource="ic_steps" />
        </PartImage>
        <PartText x="64" y="298" width="88" height="32" name="steps_value">
          <Launch target="com.fitbit.FitbitMobile" />
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
              <Template><![CDATA[%,d]]>
                <Parameter expression="[STEP_COUNT]" />
              </Template>
            </Font>
          </Text>
        </PartText>
        <Condition>
          <Expressions>
            <Expression name="steps_has_goal"><![CDATA[[STEP_GOAL] > 0]]></Expression>
          </Expressions>
          <Compare expression="steps_has_goal">
            <PartText x="64" y="328" width="88" height="16" name="steps_goal">
              <Launch target="com.fitbit.FitbitMobile" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" color="#ff8f98a3">
                  <Template><![CDATA[/ %,d]]>
                    <Parameter expression="[STEP_GOAL]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="64" y="328" width="88" height="16" name="steps_unit">
              <Launch target="com.fitbit.FitbitMobile" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" color="#ff8f98a3">steps</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Editable complication slots                                  -->
    <!-- The slot rectangle is the drawing area for the slot's parts; -->
    <!-- BoundingBox is the touch / editor-highlight region.          -->
    <!-- ============================================================ -->

    <!-- Next alarm (2 o'clock; user assigns the clock app's alarm complication) -->
    <ComplicationSlot x="300" y="96" width="100" height="72" slotId="10"
        displayName="slot_alarm" isCustomizable="TRUE"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="100" height="72" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="SHORT_TEXT">
        <PartImage x="36" y="2" width="28" height="28" name="alarm_icon_st" tintColor="[CONFIGURATION.color.1]">
          <Image resource="ic_alarm" />
        </PartImage>
        <Condition>
          <Expressions>
            <Expression name="alarm_has_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="alarm_has_text">
            <PartText x="10" y="34" width="80" height="32" name="alarm_text">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="10" y="34" width="80" height="32" name="alarm_none">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="16" color="#ff6b7480">なし</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
      </Complication>

      <Complication type="MONOCHROMATIC_IMAGE">
