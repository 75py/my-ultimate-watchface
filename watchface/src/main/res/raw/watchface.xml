    <!-- Distance (6 o'clock; user assigns a distance complication).
         The slot rectangle also contains the 156°–204° rim segment so the
         GOAL_PROGRESS arc can be drawn from real complication data.
         Slot origin = (130, 200); ring center = (95, 25) in slot coordinates. -->
    <ComplicationSlot x="130" y="200" width="190" height="250" slotId="11"
        displayName="slot_distance" isCustomizable="TRUE"
        supportedTypes="GOAL_PROGRESS SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="45" y="102" width="100" height="78" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="GOAL_PROGRESS">
        <Condition>
          <Expressions>
            <Expression name="dist_has_goal"><![CDATA[[COMPLICATION.GOAL_PROGRESS_TARGET_VALUE] > 0]]></Expression>
          </Expressions>
          <Compare expression="dist_has_goal">
            <PartDraw x="0" y="0" width="190" height="250" name="dist_arc_glow" alpha="40">
              <Arc centerX="95" centerY="25" width="408" height="408" startAngle="156" endAngle="156">
                <Stroke color="[CONFIGURATION.color.1]" thickness="20" cap="ROUND" />
                <Transform target="endAngle" value="156 + clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE], 0, 1) * 48" />
