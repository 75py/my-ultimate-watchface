<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  My Ultimate Watch Face — Watch Face Format v2 (Wear OS 5 / API 34+)

  Pastel theme layout on a 450x450 virtual canvas (scaled to the physical
  display), from the Figma design (exported via WatchFaceDesigner):
    - top center    : date (M月D日（曜）)
    - below date    : weather block (icon + current temp + today high/low + condition name)
    - center        : large HH:MM slightly above the geometric center,
                      per-digit boxes so changing digits never shift the layout
    - right of MM   : small bold seconds (interactive mode only)
    - upper left    : heart rate (heart icon + value + bpm)
    - upper right   : next alarm (bell icon + time, editable complication slot)
    - left-lower    : steps (shoe icon + count)
    - bottom        : distance (pin icon + value + km, editable complication slot)
    - right-lower   : calories burned (flame icon + value + kcal, editable slot)
  Decorative tapered swoosh arcs sit on the rim at each item's clock position;
  every accent element is tinted with the user-selected theme color
  ([CONFIGURATION.color.1]) over a dark track color ([CONFIGURATION.color.2]).
  Ambient (AOD): only dimmed HH:MM remains, at the identical position.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:36" />

  <!-- Theme colors: color.1 = pastel accent, color.2 = dark track -->
  <UserConfigurations>
    <ColorConfiguration id="color" displayName="color_theme" defaultValue="mint">
      <ColorOption id="mint" displayName="color_mint" colors="#00000000 #ffbdfff1 #ff28483f" />
      <ColorOption id="blue" displayName="color_blue" colors="#00000000 #ffbbdfff #ff2b4055" />
      <ColorOption id="orange" displayName="color_orange" colors="#00000000 #ffffd4af #ff533e2d" />
    </ColorConfiguration>
  </UserConfigurations>

  <BitmapFonts>
    <!-- Weather condition icons, selected by the [WEATHER.CONDITION] enum value
         rendered through a BitmapFont (same technique as the official Weather sample).
         These PNGs are already colored, so no tint is applied. -->
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_clear_day" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_sunny" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_day" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_night" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_night" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_night" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>

    <!-- Inter bitmap fonts for the clock (exported with the Figma design).
         White glyphs tinted by the theme accent color. -->
    <BitmapFont name="interregular">
      <Character name="0" resource="font_interregular_0" width="125" height="200" />
      <Character name="1" resource="font_interregular_1" width="93" height="200" />
      <Character name="2" resource="font_interregular_2" width="122" height="200" />
      <Character name="3" resource="font_interregular_3" width="128" height="200" />
      <Character name="4" resource="font_interregular_4" width="129" height="200" />
      <Character name="5" resource="font_interregular_5" width="122" height="200" />
      <Character name="6" resource="font_interregular_6" width="125" height="200" />
      <Character name="7" resource="font_interregular_7" width="115" height="200" />
      <Character name="8" resource="font_interregular_8" width="124" height="200" />
      <Character name="9" resource="font_interregular_9" width="125" height="200" />
      <Character name=":" resource="font_interregular_colon" width="56" height="200" />
      <Character name="." resource="font_interregular_dot" width="56" height="200" />
      <Character name="-" resource="font_interregular_hyphen" width="92" height="200" />
      <Character name="A" resource="font_interregular_a_upper" width="136" height="200" />
      <Character name="P" resource="font_interregular_p_upper" width="127" height="200" />
      <Character name="M" resource="font_interregular_m_upper" width="178" height="200" />
      <Character name="a" resource="font_interregular_a" width="113" height="200" />
      <Character name="p" resource="font_interregular_p" width="122" height="200" />
      <Character name="m" resource="font_interregular_m" width="174" height="200" />
    </BitmapFont>
    <BitmapFont name="interbold">
      <Character name="0" resource="font_interbold_0" width="138" height="200" />
      <Character name="1" resource="font_interbold_1" width="98" height="200" />
      <Character name="2" resource="font_interbold_2" width="126" height="200" />
      <Character name="3" resource="font_interbold_3" width="132" height="200" />
      <Character name="4" resource="font_interbold_4" width="136" height="200" />
      <Character name="5" resource="font_interbold_5" width="129" height="200" />
      <Character name="6" resource="font_interbold_6" width="133" height="200" />
      <Character name="7" resource="font_interbold_7" width="119" height="200" />
      <Character name="8" resource="font_interbold_8" width="133" height="200" />
      <Character name="9" resource="font_interbold_9" width="133" height="200" />
      <Character name=":" resource="font_interbold_colon" width="60" height="200" />
      <Character name="." resource="font_interbold_dot" width="60" height="200" />
      <Character name="-" resource="font_interbold_hyphen" width="94" height="200" />
      <Character name="A" resource="font_interbold_a_upper" width="150" height="200" />
      <Character name="P" resource="font_interbold_p_upper" width="130" height="200" />
      <Character name="M" resource="font_interbold_m_upper" width="184" height="200" />
      <Character name="a" resource="font_interbold_a" width="117" height="200" />
      <Character name="p" resource="font_interbold_p" width="127" height="200" />
      <Character name="m" resource="font_interbold_m" width="183" height="200" />
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff000000">

    <!-- ============================================================ -->
    <!-- Ambient-only content: dimmed HH:MM at the same position as   -->
    <!-- the interactive clock (everything else is hidden in AOD).    -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="ambient_only" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />

      <!-- dim HH:MM centered at (213, 207), per-digit fixed boxes -->
      <PartText x="89" y="162" width="56" height="90" name="aod_h10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="#ffcddad6">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([HOUR_0_23]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="145" y="162" width="56" height="90" name="aod_h1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="#ffcddad6">
            <Template><![CDATA[%s]]>
              <Parameter expression="[HOUR_0_23]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="201" y="162" width="24" height="90" name="aod_colon">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="#ffcddad6">:</BitmapFont>
        </Text>
      </PartText>
      <PartText x="225" y="162" width="56" height="90" name="aod_m10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="#ffcddad6">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([MINUTE]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="281" y="162" width="56" height="90" name="aod_m1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="#ffcddad6">
            <Template><![CDATA[%s]]>
              <Parameter expression="[MINUTE]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
    </Group>

    <!-- ============================================================ -->
    <!-- Interactive-only content (hidden in ambient mode)            -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="interactive_only" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- dark bezel ring + tick dots on the rim -->
      <PartImage x="11" y="4" width="428" height="428" name="bezel">
        <Image resource="ring_bezel" />
      </PartImage>
      <PartImage x="15" y="8" width="420" height="420" name="ticks">
        <Image resource="ring_ticks" />
      </PartImage>

      <!-- tapered swoosh arcs at each item's clock position;
           dark track (.2) behind a pastel accent (.1) -->
      <PartImage x="32" y="58" width="89" height="143" name="arc_hr_back" tintColor="[CONFIGURATION.color.2]">
          <Image resource="arc_hr_back" />
      </PartImage>
      <PartImage x="38" y="58" width="84" height="116" name="arc_hr" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_hr" />
      </PartImage>
      <PartImage x="45" y="84" width="47" height="68" name="arc_hr2" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_hr2" />
      </PartImage>
      <PartImage x="328" y="58" width="89" height="143" name="arc_alarm_back" tintColor="[CONFIGURATION.color.2]">
          <Image resource="arc_alarm_back" />
      </PartImage>
      <PartImage x="328" y="58" width="84" height="116" name="arc_alarm" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_alarm" />
      </PartImage>
      <PartImage x="31" y="213" width="91" height="165" name="arc_steps_back" tintColor="[CONFIGURATION.color.2]">
          <Image resource="arc_steps_back" />
      </PartImage>
      <PartImage x="33" y="236" width="47" height="101" name="arc_steps" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_steps" />
      </PartImage>
      <PartImage x="328" y="223" width="90" height="155" name="arc_cal_back" tintColor="[CONFIGURATION.color.2]">
          <Image resource="arc_cal_back" />
      </PartImage>
      <PartImage x="383" y="242" width="33" height="75" name="arc_cal" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_cal" />
      </PartImage>
      <PartImage x="140" y="384" width="170" height="28" name="arc_dist_back" tintColor="[CONFIGURATION.color.2]">
          <Image resource="arc_dist_back" />
      </PartImage>
      <PartImage x="140" y="384" width="64" height="26" name="arc_dist" tintColor="[CONFIGURATION.color.1]">
          <Image resource="arc_dist" />
      </PartImage>

      <!-- Date: 9月15日（火） — tap opens the calendar app -->
      <PartText x="120" y="58" width="210" height="24" name="date">
        <Launch target="CALENDAR" />
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="20" color="#fff4f3f8">
            <Template><![CDATA[%s月%s日（%s）]]>
              <Parameter expression="[MONTH]" />
              <Parameter expression="[DAY]" />
              <Parameter expression="[DAY_OF_WEEK_S]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- Weather: one consolidated area (icon + current temp + today's
           high/low + condition name). -->
      <Group x="151" y="86" width="155" height="64" name="weather">
        <Launch target="com.google.android.wearable.weather" />
        <Condition>
          <Expressions>
            <Expression name="weather_available"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
          </Expressions>
          <Compare expression="weather_available">
            <Group x="0" y="0" width="155" height="64" name="weather_ok">
              <Condition>
                <Expressions>
                  <Expression name="is_day"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                </Expressions>
                <Compare expression="is_day">
                  <PartText x="0" y="4" width="45" height="38" name="w_icon">
                    <Text>
                      <BitmapFont family="weather_icons_day" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <PartText x="0" y="4" width="45" height="38" name="w_icon_night">
                    <Text>
                      <BitmapFont family="weather_icons_night" size="38">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Default>
              </Condition>
              <PartText x="52" y="0" width="62" height="48" name="w_temp_now">
                <Text align="START">
                  <Font family="SYNC_TO_DEVICE" size="38" color="[CONFIGURATION.color.1]">
                    <Template><![CDATA[%d°]]>
                      <Parameter expression="[WEATHER.TEMPERATURE]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="112" y="26" width="43" height="15" name="w_temp_hilo">
                <Text align="START" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="12" color="#ffadb8cc">
                    <Template><![CDATA[/ %d° %d°]]>
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_HIGH]" />
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="20" y="48" width="115" height="16" name="w_condition">
                <Text align="CENTER" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="13" color="#ffadb8cc">
                    <Template><![CDATA[%s]]>
                      <Parameter expression="[WEATHER.CONDITION_NAME]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Compare>
          <Default>
            <Group x="0" y="0" width="155" height="64" name="weather_na">
              <PartText x="0" y="4" width="155" height="34" name="w_na">
                <Text align="CENTER">
                  <Font family="SYNC_TO_DEVICE" size="28" color="#ff9e9e9e">--°</Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Group>

      <!-- HH:MM — visual center (213, 207), per-digit fixed boxes so
           changing digits never shift the layout -->
      <PartText x="89" y="162" width="56" height="90" name="h10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([HOUR_0_23]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="145" y="162" width="56" height="90" name="h1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[HOUR_0_23]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="201" y="162" width="24" height="90" name="colon">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="[CONFIGURATION.color.1]">:</BitmapFont>
        </Text>
      </PartText>
      <PartText x="225" y="162" width="56" height="90" name="m10">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([MINUTE]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="281" y="162" width="56" height="90" name="m1">
        <Text align="CENTER">
          <BitmapFont family="interregular" size="84" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[MINUTE]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>

      <!-- Seconds — right of HH:MM, baseline-aligned, centered on (365, 221) -->
      <PartText x="339" y="201" width="26" height="40" name="s10">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="36" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="floor([SECOND]/10)" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>
      <PartText x="365" y="201" width="26" height="40" name="s1">
        <Text align="CENTER">
          <BitmapFont family="interbold" size="36" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%s]]>
              <Parameter expression="[SECOND]%10" />
            </Template>
          </BitmapFont>
        </Text>
      </PartText>

      <!-- Heart rate (9-11 o'clock, upper-left) -->
      <Group x="0" y="0" width="450" height="450" name="heart_rate">
        <PartImage x="85" y="100" width="22" height="19" name="hr_icon" tintColor="[CONFIGURATION.color.1]">
          <Launch target="HEALTH_HEART_RATE" />
          <Image resource="ic_heart" />
        </PartImage>
        <Condition>
          <Expressions>
            <Expression name="hr_valid"><![CDATA[round([HEART_RATE]) >= 1]]></Expression>
          </Expressions>
          <Compare expression="hr_valid">
            <PartText x="65" y="120" width="62" height="32" name="hr_value">
              <Launch target="HEALTH_HEART_RATE" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.color.1]">
                  <Template><![CDATA[%d]]>
                    <Parameter expression="round([HEART_RATE])" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="65" y="120" width="62" height="32" name="hr_value_na">
              <Launch target="HEALTH_HEART_RATE" />
              <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" color="#ff9e9e9e">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartImage x="83" y="152" width="26" height="12" name="hr_bpm">
          <Launch target="HEALTH_HEART_RATE" />
          <Image resource="label_bpm" />
        </PartImage>
      </Group>

      <!-- Steps (7-9 o'clock, left-lower): layered shoe icon + count;
           tapping any element opens the health app (Fitbit on Pixel Watch) -->
      <PartImage x="108" y="274" width="21" height="20" name="steps_icon_a" tintColor="[CONFIGURATION.color.1]">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps" />
      </PartImage>
      <PartImage x="108" y="274" width="21" height="20" name="steps_icon_b" tintColor="[CONFIGURATION.color.2]">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps_b" />
      </PartImage>
      <PartImage x="108" y="283" width="21" height="12" name="steps_icon_c" tintColor="[CONFIGURATION.color.1]">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps_c" />
      </PartImage>
      <PartImage x="108" y="283" width="21" height="12" name="steps_icon_d" tintColor="[CONFIGURATION.color.2]">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps_d" />
      </PartImage>
      <PartImage x="112" y="282" width="7" height="6" name="steps_icon_e">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps_e" />
      </PartImage>
      <PartImage x="112" y="281" width="8" height="7" name="steps_icon_f" tintColor="[CONFIGURATION.color.2]">
        <Launch target="com.fitbit.FitbitMobile" />
        <Image resource="ic_steps_f" />
      </PartImage>
      <PartText x="77" y="294" width="83" height="26" name="steps_value">
        <Launch target="com.fitbit.FitbitMobile" />
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="21" color="[CONFIGURATION.color.1]">
            <Template><![CDATA[%,d]]>
              <Parameter expression="[STEP_COUNT]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- Distance decorations (5-7 o'clock, bottom): pin icon + km label;
           the value itself is the editable slot below -->
      <PartImage x="218" y="311" width="13" height="19" name="dist_pin" tintColor="[CONFIGURATION.color.1]">
          <Image resource="ic_distance" />
      </PartImage>
      <PartImage x="217" y="357" width="17" height="10" name="dist_km">
        <Image resource="label_km" />
      </PartImage>

      <!-- Calories decorations (3-5 o'clock, right-lower): flame + kcal label -->
      <PartImage x="322" y="276" width="15" height="20" name="cal_flame" tintColor="[CONFIGURATION.color.1]">
          <Image resource="ic_calories" />
      </PartImage>
      <PartImage x="317" y="321" width="23" height="10" name="cal_kcal">
        <Image resource="label_kcal" />
      </PartImage>
    </Group>

    <!-- ============================================================ -->
    <!-- Editable complication slots                                  -->
    <!-- ============================================================ -->

    <!-- Next alarm (1-3 o'clock; user assigns the clock app's alarm complication) -->
    <ComplicationSlot x="330" y="100" width="49" height="65" slotId="10"
        displayName="slot_alarm" isCustomizable="TRUE"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY">
      <BoundingBox x="0" y="0" width="49" height="65" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="SHORT_TEXT">
        <PartImage x="14" y="-1" width="22" height="21" name="alarm_icon_back_st" tintColor="[CONFIGURATION.color.1]">
          <Image resource="ic_alarm_back" />
        </PartImage>
        <PartImage x="15" y="1" width="18" height="18" name="alarm_icon_st" tintColor="[CONFIGURATION.color.1]">
          <Image resource="ic_alarm" />
        </PartImage>
        <Condition>
          <Expressions>
