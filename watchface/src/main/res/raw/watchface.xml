<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  My Ultimate Watch Face — Watch Face Format v2 (Wear OS 5 / API 34+)

  Monochrome mint-on-black design (see sample_v2.png), 450x450 virtual canvas:
    - top center   : date  "9月15日 (火)"
    - below date   : weather block (mono icon + current temp + "/ low" + condition name)
    - upper middle : large HH:MM, per-digit boxes so changing digits never shift,
                     small seconds to the right (interactive mode only)
    - lower half   : five ring gauges, icon sitting in the gap at the bottom of each ring
        row 1: steps (STEP_PERCENT ring) | distance slot | calories slot
        row 2: heart rate                | next-alarm slot
      Rings are drawn as a dim 310° track plus a bright progress arc. Progress is
      only shown where a real value exists: steps ([STEP_PERCENT]) and GOAL_PROGRESS /
      RANGED_VALUE complications (read inside their own slot). Heart rate, alarm and
      SHORT_TEXT providers get a fully-lit ring; an EMPTY slot shows only the dim track.
  Ambient (AOD): only the date and HH:MM remain, dimmed, at identical positions.

  Palette: mint #cbfdf1 (primary), track #2f473f, date #e5ebe8,
           secondary text #9ba5b4 / #b2bdcd.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">

  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:36" />
  <Metadata key="STEP_GOAL" value="10000" />

  <!-- Weather condition icons (monochrome mint, Material Symbols), selected by the
       [WEATHER.CONDITION] enum value rendered through a BitmapFont. -->
  <BitmapFonts>
    <BitmapFont name="weather_icons_day">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_clear_day" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_sunny" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_day" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
    <BitmapFont name="weather_icons_night">
      <Character name="0" resource="w_unknown" width="96" height="96" />
      <Character name="1" resource="w_night" width="96" height="96" />
      <Character name="2" resource="w_cloud" width="96" height="96" />
      <Character name="3" resource="w_fog" width="96" height="96" />
      <Character name="4" resource="w_heavy_rain" width="96" height="96" />
      <Character name="5" resource="w_heavy_snow" width="96" height="96" />
      <Character name="6" resource="w_rain" width="96" height="96" />
      <Character name="7" resource="w_snow" width="96" height="96" />
      <Character name="8" resource="w_night" width="96" height="96" />
      <Character name="9" resource="w_thunder" width="96" height="96" />
      <Word name="10" resource="w_sleet" width="96" height="96" />
      <Word name="11" resource="w_light_snow" width="96" height="96" />
      <Word name="12" resource="w_light_rain" width="96" height="96" />
      <Word name="13" resource="w_mist" width="96" height="96" />
      <Word name="14" resource="w_partly_night" width="96" height="96" />
      <Word name="15" resource="w_wind" width="96" height="96" />
    </BitmapFont>
  </BitmapFonts>

  <Scene backgroundColor="#ff000000">

    <!-- ============================================================ -->
    <!-- Elements kept in ambient mode (dimmed): date + HH:MM         -->
    <!-- Their geometry never changes between interactive and ambient -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="ambient_kept">
      <Variant mode="AMBIENT" target="alpha" value="150" />

      <!-- Date: 9月15日 (火) — tap opens the calendar app -->
      <PartText x="75" y="22" width="300" height="32" name="date">
        <Launch target="CALENDAR" />
        <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="22" color="#ffe5ebe8">
            <Template><![CDATA[%s月%s日 (%s)]]>
              <Parameter expression="[MONTH]" />
              <Parameter expression="[DAY]" />
              <Parameter expression="[DAY_OF_WEEK_S]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- HH:MM — centred on x=214 (the seconds sit to its right), digits centred
           on y=182. Per-digit boxes keep every glyph in place while the value changes. -->
      <Group x="104" y="132" width="220" height="100" name="clock">
        <DigitalClock x="0" y="0" width="220" height="100">
          <Localization calendar="GREGORIAN" timeZone="SYNC_TO_DEVICE" />
          <TimeText format="hh_10" hourFormat="24" x="0" y="0" width="48" height="100" align="CENTER">
            <Font family="poppins_regular" size="82" color="#ffcbfdf1" />
          </TimeText>
          <TimeText format="hh_1" hourFormat="24" x="48" y="0" width="48" height="100" align="CENTER">
            <Font family="poppins_regular" size="82" color="#ffcbfdf1" />
          </TimeText>
          <TimeText format="mm_10" hourFormat="24" x="124" y="0" width="48" height="100" align="CENTER">
            <Font family="poppins_regular" size="82" color="#ffcbfdf1" />
          </TimeText>
          <TimeText format="mm_1" hourFormat="24" x="172" y="0" width="48" height="100" align="CENTER">
            <Font family="poppins_regular" size="82" color="#ffcbfdf1" />
          </TimeText>
        </DigitalClock>
        <!-- static separator: never moves -->
        <PartText x="96" y="0" width="28" height="100" name="colon">
          <Text align="CENTER">
            <Font family="poppins_regular" size="82" color="#ffcbfdf1">:</Font>
          </Text>
        </PartText>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Interactive-only content (hidden in ambient mode)            -->
    <!-- ============================================================ -->
    <Group x="0" y="0" width="450" height="450" name="interactive_only" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- Weather: mono icon + current temp + "/ low" + condition name. -->
      <Group x="105" y="45" width="240" height="88" name="weather">
        <Launch target="com.google.android.wearable.weather" />
        <Condition>
          <Expressions>
            <Expression name="weather_available"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
          </Expressions>
          <Compare expression="weather_available">
            <Group x="0" y="0" width="240" height="88" name="weather_ok">
              <Condition>
                <Expressions>
                  <Expression name="is_day"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                </Expressions>
                <Compare expression="is_day">
                  <PartText x="15" y="0" width="72" height="72" name="w_icon">
                    <Text align="CENTER">
                      <BitmapFont family="weather_icons_day" size="72">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <PartText x="15" y="0" width="72" height="72" name="w_icon_night">
                    <Text align="CENTER">
                      <BitmapFont family="weather_icons_night" size="72">
                        <Template><![CDATA[%s]]>
                          <Parameter expression="[WEATHER.IS_ERROR] ? 0 : ([WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0)" />
                        </Template>
                      </BitmapFont>
                    </Text>
                  </PartText>
                </Default>
              </Condition>
              <!-- current temperature, large -->
              <PartText x="95" y="6" width="84" height="66" name="w_temp_now">
                <Text align="START">
                  <Font family="poppins_regular" size="54" color="#ffcbfdf1">
                    <Template><![CDATA[%d°]]>
                      <Parameter expression="[WEATHER.TEMPERATURE]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <!-- today's low, small and muted, baseline-aligned with the big number -->
              <PartText x="176" y="27" width="64" height="36" name="w_temp_low">
                <Text align="START">
                  <Font family="poppins_regular" size="28" color="#ff9ba5b4">
                    <Template><![CDATA[/ %d°]]>
                      <Parameter expression="[WEATHER.DAY_TEMPERATURE_LOW]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
              <PartText x="0" y="64" width="240" height="24" name="w_condition">
                <Text align="CENTER" ellipsis="TRUE">
                  <Font family="SYNC_TO_DEVICE" size="17" color="#ffb2bdcd">
                    <Template><![CDATA[%s]]>
                      <Parameter expression="[WEATHER.CONDITION_NAME]" />
                    </Template>
                  </Font>
                </Text>
              </PartText>
            </Group>
          </Compare>
          <Default>
            <Group x="0" y="0" width="240" height="88" name="weather_na">
              <PartText x="15" y="0" width="72" height="72" name="w_icon_na">
                <Text align="CENTER">
                  <BitmapFont family="weather_icons_day" size="72">0</BitmapFont>
                </Text>
              </PartText>
              <PartText x="95" y="6" width="84" height="66" name="w_na">
                <Text align="START">
                  <Font family="poppins_regular" size="54" color="#ff9ba5b4">--°</Font>
                </Text>
              </PartText>
            </Group>
          </Default>
        </Condition>
      </Group>

      <!-- Seconds — right of HH:MM, bottom-aligned with the big digits -->
      <PartText x="330" y="180" width="60" height="40" name="seconds">
        <Text align="START">
          <Font family="poppins_regular" size="34" color="#ffcbfdf1">
            <Template><![CDATA[%s]]>
              <Parameter expression="[SECOND_Z]" />
            </Template>
          </Font>
        </Text>
      </PartText>

      <!-- ============================================================ -->
      <!-- Row 1, left: steps ring (progress = STEP_PERCENT)            -->
      <!-- ring centre (124,283), radius 33, stroke 5, 310° track       -->
      <!-- ============================================================ -->
      <Group x="82" y="241" width="84" height="86" name="steps">
        <Launch target="com.fitbit.FitbitMobile" />
        <PartDraw x="0" y="0" width="84" height="84" name="steps_track">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
            <Stroke color="#ff2f473f" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="has_step_goal"><![CDATA[[STEP_GOAL] > 0]]></Expression>
          </Expressions>
          <Compare expression="has_step_goal">
            <PartDraw x="0" y="0" width="84" height="84" name="steps_progress">
              <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="-155">
                <Stroke color="#ffcbfdf1" thickness="5" cap="ROUND" />
                <Transform target="endAngle" value="-155 + (clamp([STEP_PERCENT], 0, 100) / 100) * 310" />
              </Arc>
            </PartDraw>
          </Compare>
          <Default>
            <Group x="0" y="0" width="1" height="1" name="steps_progress_none" />
          </Default>
        </Condition>
        <!-- value: shrink once it reaches five digits so it stays inside the ring -->
        <Condition>
          <Expressions>
            <Expression name="steps_5digits"><![CDATA[[STEP_COUNT] >= 10000]]></Expression>
          </Expressions>
          <Compare expression="steps_5digits">
            <PartText x="0" y="26" width="84" height="32" name="steps_value_5">
              <Text align="CENTER">
                <Font family="poppins_regular" size="20" color="#ffcbfdf1">
                  <Template><![CDATA[%,d]]>
                    <Parameter expression="[STEP_COUNT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="0" y="26" width="84" height="32" name="steps_value">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ffcbfdf1">
                  <Template><![CDATA[%,d]]>
                    <Parameter expression="[STEP_COUNT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartImage x="28" y="56" width="28" height="28" name="steps_icon">
          <Image resource="ic_steps" />
        </PartImage>
      </Group>

      <!-- ============================================================ -->
      <!-- Row 2, left: heart-rate ring (fully lit; no goal exists)     -->
      <!-- ring centre (176,374), radius 28, stroke 5                   -->
      <!-- ============================================================ -->
      <Group x="140" y="338" width="72" height="78" name="heart_rate">
        <Launch target="HEALTH_HEART_RATE" />
        <PartDraw x="0" y="0" width="72" height="72" name="hr_ring">
          <Arc centerX="36" centerY="36" width="56" height="56" startAngle="-155" endAngle="155">
            <Stroke color="#ffcbfdf1" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="hr_valid"><![CDATA[round([HEART_RATE]) >= 1]]></Expression>
          </Expressions>
          <Compare expression="hr_valid">
            <PartText x="0" y="18" width="72" height="32" name="hr_value">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ffcbfdf1">
                  <Template><![CDATA[%d]]>
                    <Parameter expression="round([HEART_RATE])" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="0" y="18" width="72" height="32" name="hr_value_na">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ff9ba5b4">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <PartImage x="24" y="48" width="24" height="24" name="hr_icon">
          <Image resource="ic_heart" />
        </PartImage>
      </Group>
    </Group>

    <!-- ============================================================ -->
    <!-- Editable complication slots (each draws its own ring)        -->
    <!-- ============================================================ -->

    <!-- Row 1, centre: distance. ring centre (226,283), radius 33 -->
    <ComplicationSlot x="184" y="241" width="84" height="86" slotId="11"
        displayName="slot_distance" isCustomizable="TRUE"
        supportedTypes="GOAL_PROGRESS RANGED_VALUE SHORT_TEXT EMPTY">
      <BoundingOval x="0" y="0" width="84" height="84" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="GOAL_PROGRESS">
        <PartDraw x="0" y="0" width="84" height="84" name="dist_track_gp">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
            <Stroke color="#ff2f473f" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartDraw x="0" y="0" width="84" height="84" name="dist_progress_gp">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="-155">
            <Stroke color="#ffcbfdf1" thickness="5" cap="ROUND" />
            <Transform target="endAngle" value="-155 + ([COMPLICATION.GOAL_PROGRESS_TARGET_VALUE] > 0 ? clamp([COMPLICATION.GOAL_PROGRESS_VALUE] / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE], 0, 1) : 0) * 310" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="dist_gp_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_gp_text">
            <PartText x="4" y="20" width="76" height="32" name="dist_gp_value">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="24" color="#ffcbfdf1">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="4" y="20" width="76" height="32" name="dist_gp_na">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ff9ba5b4">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="dist_gp_title"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_gp_title">
            <PartText x="8" y="49" width="68" height="14" name="dist_gp_unit">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="11" color="#ff9ba5b4">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TITLE]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <Group x="0" y="0" width="1" height="1" name="dist_gp_unit_none" />
          </Default>
        </Condition>
        <PartImage x="28" y="56" width="28" height="28" name="dist_icon_gp">
          <Image resource="ic_distance" />
        </PartImage>
      </Complication>

      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="84" height="84" name="dist_track_rv">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
            <Stroke color="#ff2f473f" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartDraw x="0" y="0" width="84" height="84" name="dist_progress_rv">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="-155">
            <Stroke color="#ffcbfdf1" thickness="5" cap="ROUND" />
            <Transform target="endAngle" value="-155 + ([COMPLICATION.RANGED_VALUE_MAX] > [COMPLICATION.RANGED_VALUE_MIN] ? clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) : 0) * 310" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="dist_rv_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_rv_text">
            <PartText x="4" y="20" width="76" height="32" name="dist_rv_value">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="24" color="#ffcbfdf1">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="4" y="20" width="76" height="32" name="dist_rv_na">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ff9ba5b4">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="dist_rv_title"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_rv_title">
            <PartText x="8" y="49" width="68" height="14" name="dist_rv_unit">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="11" color="#ff9ba5b4">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TITLE]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <Group x="0" y="0" width="1" height="1" name="dist_rv_unit_none" />
          </Default>
        </Condition>
        <PartImage x="28" y="56" width="28" height="28" name="dist_icon_rv">
          <Image resource="ic_distance" />
        </PartImage>
      </Complication>

      <Complication type="SHORT_TEXT">
        <!-- no numeric range available: fully-lit ring -->
        <PartDraw x="0" y="0" width="84" height="84" name="dist_ring_st">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
            <Stroke color="#ffcbfdf1" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <Condition>
          <Expressions>
            <Expression name="dist_st_text"><![CDATA[[COMPLICATION.TEXT] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_st_text">
            <PartText x="4" y="20" width="76" height="32" name="dist_st_value">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="24" color="#ffcbfdf1">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TEXT]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <PartText x="4" y="20" width="76" height="32" name="dist_st_na">
              <Text align="CENTER">
                <Font family="poppins_regular" size="24" color="#ff9ba5b4">--</Font>
              </Text>
            </PartText>
          </Default>
        </Condition>
        <Condition>
          <Expressions>
            <Expression name="dist_st_title"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
          </Expressions>
          <Compare expression="dist_st_title">
            <PartText x="8" y="49" width="68" height="14" name="dist_st_unit">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="poppins_regular" size="11" color="#ff9ba5b4">
                  <Template><![CDATA[%s]]>
                    <Parameter expression="[COMPLICATION.TITLE]" />
                  </Template>
                </Font>
              </Text>
            </PartText>
          </Compare>
          <Default>
            <Group x="0" y="0" width="1" height="1" name="dist_st_unit_none" />
          </Default>
        </Condition>
        <PartImage x="28" y="56" width="28" height="28" name="dist_icon_st">
          <Image resource="ic_distance" />
        </PartImage>
      </Complication>

      <Complication type="EMPTY">
        <!-- nothing assigned: dim track only, tap opens Fitbit -->
        <PartDraw x="0" y="0" width="84" height="84" name="dist_track_empty">
          <Launch target="com.fitbit.FitbitMobile" />
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
            <Stroke color="#ff2f473f" thickness="5" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartText x="4" y="20" width="76" height="32" name="dist_empty">
          <Launch target="com.fitbit.FitbitMobile" />
          <Text align="CENTER">
            <Font family="poppins_regular" size="24" color="#ff9ba5b4">--</Font>
          </Text>
        </PartText>
        <PartImage x="28" y="56" width="28" height="28" name="dist_icon_empty">
          <Launch target="com.fitbit.FitbitMobile" />
          <Image resource="ic_distance" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Row 1, right: calories burned. ring centre (328,283), radius 33 -->
    <ComplicationSlot x="286" y="241" width="84" height="86" slotId="12"
        displayName="slot_calories" isCustomizable="TRUE"
        supportedTypes="GOAL_PROGRESS RANGED_VALUE SHORT_TEXT EMPTY">
      <BoundingOval x="0" y="0" width="84" height="84" outlinePadding="2.0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <Complication type="GOAL_PROGRESS">
        <PartDraw x="0" y="0" width="84" height="84" name="cal_track_gp">
          <Arc centerX="42" centerY="42" width="66" height="66" startAngle="-155" endAngle="155">
