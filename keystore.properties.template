# Release signing settings for the watch face APK/AAB.
# Copy this file to "keystore.properties" in the project root and fill in real
# values. keystore.properties is git-ignored and must never be committed.
#
# Alternatively, the same values can be supplied via environment variables:
#   MUWF_STOREFILE, MUWF_STOREPASSWORD, MUWF_KEYALIAS, MUWF_KEYPASSWORD
storeFile=release.keystore
storePassword=changeit
keyAlias=my-key-alias
keyPassword=changeit
